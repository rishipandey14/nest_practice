<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Welcome</title>
  </head>

  <body style="margin: 0; padding: 0; background-color: #f4f7fb; font-family: Arial, Helvetica, sans-serif; color: #333333;">
    <table
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="background-color: #f4f7fb; padding: 40px 20px;"
    >
      <tr>
        <td align="center">

          <table
            width="600"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="max-width: 600px; width: 100%; background-color: #ffffff; border-radius: 10px; overflow: hidden;"
          >

            <!-- Header -->
            <tr>
              <td
                align="center"
                style="background-color: #2563eb; padding: 35px 30px; color: #ffffff;"
              >
                <h1 style="margin: 0; font-size: 28px;">
                  Welcome, {{name}}! 👋
                </h1>

                <p style="margin: 10px 0 0; font-size: 16px; color: #dbeafe;">
                  We're excited to have you with us.
                </p>
              </td>
            </tr>

            <!-- Main Content -->
            <tr>
              <td style="padding: 35px 30px;">

                <p style="margin: 0 0 18px; font-size: 16px; line-height: 1.6;">
                  Hi {{name}},
                </p>

                <p style="margin: 0 0 18px; font-size: 16px; line-height: 1.6;">
                  Thank you for creating an account with us. We're happy to
                  welcome you to our platform!
                </p>

                <p style="margin: 0 0 25px; font-size: 16px; line-height: 1.6;">
                  Your account has been successfully created and is now ready
                  to use. You can sign in using the credentials you provided
                  during registration.
                </p>

                <!-- Account Status -->
                <table
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="background-color: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px; margin-bottom: 25px;"
                >
                  <tr>
                    <td style="padding: 18px;">

                      <p
                        style="margin: 0 0 8px; font-size: 16px; font-weight: bold; color: #166534;"
                      >
                        ✓ Account Successfully Created
                      </p>

                      <p
                        style="margin: 0; font-size: 14px; line-height: 1.5; color: #365314;"
                      >
                        Your registration has been completed successfully.
                        Your account is ready and you can start using our
                        services.
                      </p>

                    </td>
                  </tr>
                </table>

                <p style="margin: 0 0 18px; font-size: 15px; line-height: 1.6; color: #555555;">
                  We recommend keeping your account credentials secure and
                  avoiding sharing your password with anyone.
                </p>

                <p style="margin: 0 0 18px; font-size: 15px; line-height: 1.6; color: #555555;">
                  If you did not create this account, please contact our
                  support team as soon as possible.
                </p>

                <p style="margin: 25px 0 0; font-size: 15px; line-height: 1.6;">
                  Thanks again for joining us. We look forward to having you
                  with us!
                </p>

                <p style="margin: 25px 0 0; font-size: 15px; line-height: 1.6;">
                  Best regards,<br />
                  <strong>Testing Mail Service</strong>
                </p>

              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                align="center"
                style="background-color: #f8fafc; padding: 22px 30px; border-top: 1px solid #e5e7eb;"
              >
                <p style="margin: 0 0 8px; font-size: 13px; color: #64748b;">
                  This is an automated email. Please do not reply directly to
                  this message.
                </p>

                <p style="margin: 0; font-size: 12px; color: #94a3b8;">
                  © 2026 Testing Mail Service. All rights reserved.
                </p>
              </td>
            </tr>

          </table>

        </td>
      </tr>
    </table>
  </body>
</html>
